{
  "name": "milenmk/laravel-livewire-crud",
  "description": "A reusable CRUD package for Laravel controllers and Livewire components, designed to simplify and standardize common database operations(create, read, update, delete), reduce boilerplate code, and support bulk actions.",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Milenmk\\LaravelCrud\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Milen Karaganski",
      "email": "milenmk@gmail.com"
    }
  ],
  "repository": [
    {
      "type": "git",
      "url": "https://github.com/milenmk/laravel-livewire-crud"
    }
  ],
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "larastan/larastan": "^3.7",
    "laravel/pint": "^1.24",
    "peckphp/peck": "^0.1.3",
    "rector/rector": "^2.1",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "scripts": {
    "test:typos": "./vendor/bin/peck",
    "test:refactor": "./vendor/bin/rector process --dry-run",
    "pint": "./vendor/bin/pint",
    "refactor": "./vendor/bin/rector process",
    "fix": [
      "@test:typos",
      "@refactor",
      "@pint"
    ],
    "test": [
      "@test:typos",
      "@test:refactor"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "suggest": {
    "livewire/livewire": "^3.0"
  },
  "conflict": {
    "laravel/framework": "<10.0"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}